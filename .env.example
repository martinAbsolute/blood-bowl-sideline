# Local: convex dev configures these automatically for your development backend.
CONVEX_DEPLOYMENT=dev:your-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Vercel: only CONVEX_DEPLOY_KEY is configured manually, scoped per environment.
# Production uses a production deploy key; Preview uses a preview deploy key.
# convex deploy supplies NEXT_PUBLIC_CONVEX_URL during the build.
# Enable Vercel's automatic system environment variables for metadata/auth origins.

# Convex authentication secrets (never NEXT_PUBLIC_* or committed to Git):
# TELEGRAM_CLIENT_ID
# TELEGRAM_CLIENT_SECRET
# JWT_PRIVATE_KEY
# JWKS
# Optional bot webhook secrets:
# TELEGRAM_BOT_TOKEN
# TELEGRAM_WEBHOOK_SECRET

# Local Convex auth: SITE_URL=http://localhost:3000; leave CUSTOM_AUTH_SITE_URL unset.
# Vercel builds automatically set SITE_URL and CUSTOM_AUTH_SITE_URL in Convex.
