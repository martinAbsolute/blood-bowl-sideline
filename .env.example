# Frontend: use your dev deployment locally, production URL on Vercel production.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TELEGRAM_AUTH_READY=false
CONVEX_DEPLOYMENT=dev:your-deployment

# Store these ONLY in Convex environment variables, not NEXT_PUBLIC_*:
# TELEGRAM_BOT_USERNAME=bb_sideline_bot
# TELEGRAM_CLIENT_ID=8809799343
# TELEGRAM_CLIENT_SECRET
# TELEGRAM_BOT_TOKEN
# TELEGRAM_WEBHOOK_SECRET
# JWT_PRIVATE_KEY
# JWKS
# SITE_URL

# CI only: store CONVEX_DEPLOY_KEY as a Vercel Production secret, never NEXT_PUBLIC_* or Git.
