# Local: convex dev configures these automatically for your development backend.
CONVEX_DEPLOYMENT=dev:your-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Vercel: only CONVEX_DEPLOY_KEY is configured manually, scoped per environment.
# Production uses a production deploy key; Preview uses a preview deploy key.
# Development uses the development deploy key; pull it locally with vercel env pull.
# convex deploy supplies NEXT_PUBLIC_CONVEX_URL and NEXT_PUBLIC_CONVEX_SITE_URL.
# Enable Vercel's automatic system environment variables for metadata.

# Convex authentication secrets (never NEXT_PUBLIC_* or committed to Git):
# TELEGRAM_CLIENT_ID
# TELEGRAM_CLIENT_SECRET
# JWT_PRIVATE_KEY
# JWKS
# Optional bot webhook secrets:
# TELEGRAM_BOT_TOKEN
# TELEGRAM_WEBHOOK_SECRET

# Local Convex auth: SITE_URL=http://localhost:3000 (OAuth uses the Convex HTTPS callback).
# Hosted Convex auth: configure SITE_URL to the app HTTPS origin.

# Optional local / Vercel Preview sign-in. Leave disabled in Production.
# Use the same server-only secret in the isolated Convex backend.
DEV_AUTH_ENABLED=false
# DEV_AUTH_SECRET=<random secret, at least 32 bytes>
# Convex-only configuration, set in that deployment's dashboard:
# DEV_AUTH_DEPLOYMENT_TYPE=dev (or preview)
# DEV_AUTH_DEPLOYMENT_NAME=<actual nonproduction deployment name>
# See docs/development-auth.md for both independent gates.
